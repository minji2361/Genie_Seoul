# 로컬: .env.local 에 복사 후 값 입력
# Vercel: Project → Settings → Environment Variables 에 동일 키 등록 후 Redeploy 필수
# (.env.local 은 git에 올라가지 않습니다)

# App (선택)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Supabase — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 코치 로그인 (사이트 로그인용 — Vercel에 반드시 설정)
ADMIN_ID=jn@jn.com
ADMIN_PASSWORD=Jn1234!
SESSION_SECRET=긴-랜덤-문자열-32자-이상
