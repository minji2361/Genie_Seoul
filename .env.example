# 로컬: .env.local 에 복사 후 값 입력
# Vercel: Project → Settings → Environment Variables 에 동일 키 등록 후 Redeploy 필수
# (.env.local 은 git에 올라가지 않습니다)

# App (선택 — 미설정 시 https://www.genie-land.com 사용)
NEXT_PUBLIC_SITE_URL=https://www.genie-land.com

# 검색엔진 소유 확인 (Search Console / 서치어드바이저에서 발급한 코드만 입력)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=구글에서_준_코드
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION=네이버에서_준_코드

# Supabase — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버 전용 — Dashboard → Settings → API → service_role (인터뷰/대상자 등록 RLS 우회용, 서버에만 설정)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 코치 로그인 (상담사 전원 공유 계정)
ADMIN_ID=coach@example.com
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me

# 관리자 로그인 (코치 로그인과 별도의 관리자 전용 계정 — /admin 접근 및 데이터 삭제·팝업 관리용)
SUPER_ADMIN_ID=admin@example.com
SUPER_ADMIN_PASSWORD=change-me